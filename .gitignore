# ---- Java / Maven ----
target/
build/
out/
*.class
*.jar
*.war
*.ear
.mvn/timing.properties
HELP.md

# ---- Maven Wrapper 必须入库（必须放在 *.jar 之后，否则会被上面的规则吃掉）----
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# ---- IDE ----
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志 / 临时文件 ----
*.log
logs/
*.tmp
*.bak
*.swp
*~

# ---- 敏感配置（数据库密码、密钥等，绝不入库）----
application-local.yml
application-local.properties
application-prod.yml
*-secret.yml
.env
# 本地 application.yml 里写着明文数据库密码 → 不入库
# 别人 clone 后照 application.yml.example 复制一份填上自己的密码即可
src/main/resources/application.yml

# ---- 其他 ----
node_modules/
dist/
