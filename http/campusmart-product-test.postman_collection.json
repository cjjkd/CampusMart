          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{tokenB}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"id\":{{productId}},\"title\":\"我改别人的商品\",\"price\":0.01,\"conditionLevel\":1,\"categoryId\":1}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/product/update", "host": ["{{baseUrl}}"], "path": ["product", "update"] }
          }
        },
