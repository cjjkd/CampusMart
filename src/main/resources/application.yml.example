# ============================================================
# CampusMart 配置模板
#
# 真正的 application.yml 里写着数据库密码，所以不提交到 git。
# 别人克隆项目后，照这个文件复制一份、填上自己的密码：
#
#   Windows:  copy application.yml.example application.yml
#   Mac/Linux: cp application.yml.example application.yml
# ============================================================

server:
  port: 8080

spring:
  application:
    name: CampusMart
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    # 注意最后的四个参数，缺一个都可能连不上（详见 README）
    url: jdbc:mysql://localhost:3306/campusmart?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: 换成你自己的数据库密码
  servlet:
    multipart:
      max-file-size: 2MB
      max-request-size: 5MB

mybatis-plus:
  configuration:
    # 数据库下划线 → Java 驼峰（create_time → createTime）
    map-underscore-to-camel-case: true
    # 走日志框架，可以按级别开关（见文件末尾 logging 配置）
    # 想直接看 SQL：把下面的 com.itcjj.campusmart.mapper 改成 debug
    log-impl: org.apache.ibatis.logging.slf4j.Slf4jImpl
  global-config:
    db-config:
      # 逻辑删除：删除时改成 deleted=1，查询自动加 WHERE deleted=0
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# JWT 配置
campusmart:
  jwt:
    # 签名密钥：至少 32 个字符（越长的密钥算法会自动升级，见 notes）
    # 生产环境务必换成随机长字符串，且绝不能提交到 git
    secret: 换成你自己的随机密钥至少32个字符
    # token 有效期，单位毫秒。604800000 = 7 天
    expire: 604800000
  # 上传文件的存放目录：结尾必须带 / ，路径用正斜杠（不要用反斜杠）
  # 克隆项目后请改成你自己的目录，目录不存在会自动创建
  upload:
    path: D:/upload/

# ============ 日志配置 ============
logging:
  level:
    root: info
    # 自己的代码：想看更细的流程改成 debug
    com.itcjj.campusmart: info
    # MyBatis 的 SQL 日志（logger 名 = Mapper 接口全限定名）
    # 默认 warn = 不打印 SQL；排查 SQL 问题时改成 debug 就能看到
    com.itcjj.campusmart.mapper: warn
    # 框架噪音：压到 warn，只在真出问题时才出声
    org.apache.ibatis: warn
    com.zaxxer.hikari: warn
    org.springframework.web: warn
  pattern:
    # 比默认格式精简：去掉进程号，时间只留时分秒，logger 名截短
    console: "%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"
