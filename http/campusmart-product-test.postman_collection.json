          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenA}}" }],
            "url": { "raw": "{{baseUrl}}/product/offline/{{productId}}", "host": ["{{baseUrl}}"], "path": ["product", "offline", "{{productId}}"] }
          }
        },
        {
          "name": "⚠ 04.2 再下架一次（观察：返回 0 还是 2001？）",
          "event": [
